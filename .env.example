# ==============================================================================
# GitChat 環境変数テンプレート
# ==============================================================================
# 使い方:
#   1. このファイルを .env.local にコピー
#      cp .env.example .env.local
#   2. 各値を実際のキーに置き換える
#   3. docker compose up --build で起動
#
# ⚠️ .env.local は .gitignore に含まれており Git にはコミットされません
# ==============================================================================

# ---------- Clerk 認証 ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Supabase (PostgreSQL) ----------
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ---------- Google Gemini API ----------
# API Key Rotation (Supports key _2 through _20)
# A random key will be selected for each request.
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyxxxxx
# GOOGLE_GENERATIVE_AI_API_KEY_2=AIzaSyxxxxx
# GOOGLE_GENERATIVE_AI_API_KEY_3=AIzaSyxxxxx
# ...
# GOOGLE_GENERATIVE_AI_API_KEY_20=AIzaSyxxxxx
ENCRYPTION_MASTER_KEY=xxxxx
